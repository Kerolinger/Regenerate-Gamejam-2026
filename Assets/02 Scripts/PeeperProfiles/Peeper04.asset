  name: Qris
  defaultMaterial: {fileID: 2100000, guid: 632cb32891b433c4d93f49552c8bb90e, type: 2}
  ingredient: 4
  ingredientDislikes: 5
  skillOffer: 5
  skillNeeded: 4
  st01_ingredientText: 'Hey, so here are some beets. My dad harvested too many this
    year. '
  st01_ingredientDislikeText: ' I have no potato in my soup. So don''t try any tricks...'
  st01_skillOfferText: My dad has all sorts of things in his farming shed. Like tools
    and such...
  st01_skillNeedText: 'I just split up with my partner... The new apartment is waiting
    for me, so I need help with moving my things. '
  st03_soupResultText: 'The beets really bring out the flavour... '
  st03_skillOfferText: There should be a strong enough tool in my dad's shed...
  st03_skillNeedText: 'All my things are packed, but they still need to be moved
    to the new apartment. Who can drive me through the whole city? '
