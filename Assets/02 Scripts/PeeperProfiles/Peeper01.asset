  name: Thommy
  defaultMaterial: {fileID: 2100000, guid: 76dac593878452b419b1a1afba2cf9cb, type: 2}
  ingredient: 1
  ingredientDislikes: 4
  skillOffer: 1
  skillNeeded: 2
  st01_ingredientText: 'Hi there! I have some leftover carrots for you. '
  st01_ingredientDislikeText: 'I really dislike beetroots. Love the beats, but not
    the root kind. '
  st01_skillOfferText: 'I learned a lot about being a parent through the years. '
  st01_skillNeedText: 'My kid, she had a fight with her friend in the community group.
    And I don''t have anyone to leave her with, while I go to the doctor. '
  st03_soupResultText: Oh wow! This soup is delicious.
  st03_skillOfferText: 'I could help with that! I know my way around with parent-kid
    communication. '
  st03_skillNeedText: I keep thinking about my doctor appointment, and there is no
    one to look out for my kid at the time.
